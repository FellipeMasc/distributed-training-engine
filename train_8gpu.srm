#!/bin/bash
#SBATCH --nodes=2                  #Numero de Nos (4 GPUs V100 por no na Sequana)
#SBATCH --ntasks-per-node=1        #Um torchrun por no; ele abre 1 processo por GPU
#SBATCH --gpus-per-node=4          #4 GPUs por no -> 8 GPUs no total
#SBATCH --cpus-per-task=48         #CPUs do no inteiro para dataloader/tokenizacao
#SBATCH --exclusive                #No inteiro (evita co-tenants nas GPUs)
#SBATCH -p sequana_gpu_dev         #Fila. Para runs > 20 min use sequana_gpu
#SBATCH --time=00:20:00            #Limite da fila _dev
#SBATCH -J dte_train_8gpu          #Nome do job
#SBATCH -o slurm-%j.out            #stdout+stderr no diretorio de submissao
#SBATCH -e slurm-%j.out

# ---------------------------------------------------------------------------
# Parametros do treino (sobrescreva via env: TP=2 PP=2 sbatch train_8gpu.srm)
# world_size = 8 e o script infere dp = 8 / (tp * pp).
# ---------------------------------------------------------------------------
TP=${TP:-1}
PP=${PP:-4}
MICRO_BATCH_SIZE=${MICRO_BATCH_SIZE:-4}
SEQ_LENGTH=${SEQ_LENGTH:-512}
MAX_STEPS=${MAX_STEPS:-20}
WARMUP_STEPS=${WARMUP_STEPS:-2}
# V100 nao tem bf16 nativo e fp16 puro gera NaN neste engine; fp32 e o seguro.
DTYPE=${DTYPE:-fp32}
EXTRA_ARGS=${EXTRA_ARGS:-}

# Este arquivo deve ser submetido com `sbatch`, nunca executado direto.
if [ -z "$SLURM_JOB_ID" ]; then
  echo "ERRO: rode 'sbatch $0' (fora de uma alocacao Slurm nao ha GPUs nem SLURM_*)." >&2
  exit 2
fi

echo "========================"
echo "START TIME: $(date)"
echo "JOB ID:     $SLURM_JOB_ID"
echo "NODELIST:   $SLURM_JOB_NODELIST"
scontrol show hostnames "$SLURM_JOB_NODELIST"
echo "========================"

# Raiz do repo = diretorio de onde o sbatch foi chamado (rode sbatch na raiz do repo)
REPO_DIR=${REPO_DIR:-$SLURM_SUBMIT_DIR}
cd "$REPO_DIR"
echo "REPO_DIR:   $REPO_DIR"

#Configura os Modulos
module load cuda/11.2_sequana

#Ativa o venv criado no login node (pasta tg/ dentro do repo, em /scratch).
#Sobrescreva com VENV=/caminho/para/venv sbatch ...
VENV=${VENV:-$REPO_DIR/tg}
if [ ! -f "$VENV/bin/activate" ]; then
  echo "ERRO: venv nao encontrado em $VENV (crie com: python -m venv $VENV && pip install -r requirements.txt)" >&2
  exit 2
fi
source "$VENV/bin/activate"
echo "python: $(which python) ($(python --version 2>&1))"

#Exibe as GPUs disponiveis em cada no
srun --ntasks-per-node=1 bash -c 'echo "== $(hostname) =="; nvidia-smi --query-gpu=index,name,memory.used,memory.total --format=csv'

# ---------------------------------------------------------------------------
# Rendezvous do torchrun: o primeiro no da lista e o master.
# ---------------------------------------------------------------------------
export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=$((10000 + SLURM_JOB_ID % 20000))
GPUS_PER_NODE=4
NNODES=$SLURM_JOB_NUM_NODES
WORLD_SIZE=$((GPUS_PER_NODE * NNODES))
echo "MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT WORLD_SIZE=$WORLD_SIZE"

# Nos de computacao do SDumont nao tem internet: modelo e dataset ja devem
# estar em hf_model_safetensors/ e dataset/data/ (baixados no login node).
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HOME=$REPO_DIR/.cache/huggingface
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=$((SLURM_CPUS_PER_TASK / GPUS_PER_NODE))
export CUDA_DEVICE_MAX_CONNECTIONS=1
export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1

RUN_TAG="dp$((WORLD_SIZE / (TP * PP)))_tp${TP}_pp${PP}_seq${SEQ_LENGTH}_mbs${MICRO_BATCH_SIZE}_${DTYPE}"
mkdir -p benchmarks

CMD="training/train.py \
  --tp $TP \
  --pp $PP \
  --micro-batch-size $MICRO_BATCH_SIZE \
  --seq-length $SEQ_LENGTH \
  --max-steps $MAX_STEPS \
  --warmup-steps $WARMUP_STEPS \
  --dtype $DTYPE \
  --backend nccl \
  --metrics-out benchmarks/${RUN_TAG}_job${SLURM_JOB_ID}.json \
  $EXTRA_ARGS"

LAUNCHER="torchrun \
  --nnodes=$NNODES \
  --nproc_per_node=$GPUS_PER_NODE \
  --rdzv_id=$SLURM_JOB_ID \
  --rdzv_backend=c10d \
  --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} \
  --max_restarts=0 \
  --tee 3"

echo "Running: $LAUNCHER $CMD"
srun --ntasks-per-node=1 --kill-on-bad-exit=1 $LAUNCHER $CMD
exit_status=$?

echo "========================"
echo "END TIME: $(date)  exit=$exit_status"
exit $exit_status
