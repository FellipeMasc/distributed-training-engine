#!/bin/bash
#SBATCH --nodes=2                  #Numero de Nos (4 GPUs V100 por no na Sequana)
#SBATCH --ntasks-per-node=1        #Um torchrun por no; ele abre 1 processo por GPU
#SBATCH --gpus-per-node=4          #4 GPUs por no -> 8 GPUs no total
#SBATCH --cpus-per-task=48         #CPUs do no inteiro para dataloader/tokenizacao
#SBATCH --exclusive                #No inteiro (evita co-tenants nas GPUs)
#SBATCH -p sequana_gpu_dev         #Fila. Para runs > 20 min use sequana_gpu
#SBATCH --time=00:20:00            #Limite da fila _dev
#SBATCH -J dte_train_8gpu          #Nome do job
#SBATCH -o slurm-%j.out            #stdout+stderr no diretorio de submissao
#SBATCH -e slurm-%j.out

# ---------------------------------------------------------------------------
# Parametros do treino (sobrescreva via env: TP=2 PP=2 sbatch train_8gpu.srm)
# world_size = 8 e o script infere dp = 8 / (tp * pp).
# ---------------------------------------------------------------------------
TP=${TP:-1}
PP=${PP:-4}
MICRO_BATCH_SIZE=${MICRO_BATCH_SIZE:-4}
SEQ_LENGTH=${SEQ_LENGTH:-512}
MAX_STEPS=${MAX_STEPS:-20}
WARMUP_STEPS=${WARMUP_STEPS:-2}
# V100 nao tem bf16 nativo e fp16 puro gera NaN neste engine; fp32 e o seguro.
DTYPE=${DTYPE:-fp32}
NUM_HIDDEN_LAYERS=${NUM_HIDDEN_LAYERS:-}   # opcional; vazio = usa num_hidden_layers do checkpoint
EXTRA_ARGS=${EXTRA_ARGS:-}

# Este arquivo deve ser submetido com `sbatch`, nunca executado direto.
if [ -z "$SLURM_JOB_ID" ]; then
  echo "ERRO: rode 'sbatch $0' (fora de uma alocacao Slurm nao ha GPUs nem SLURM_*)." >&2
  exit 2
fi

echo "========================"
echo "START TIME: $(date)"
echo "JOB ID:     $SLURM_JOB_ID"
echo "NODELIST:   $SLURM_JOB_NODELIST"
scontrol show hostnames "$SLURM_JOB_NODELIST"
echo "========================"

# Raiz do repo = diretorio de onde o sbatch foi chamado (rode sbatch na raiz do repo)
REPO_DIR=${REPO_DIR:-$SLURM_SUBMIT_DIR}
cd "$REPO_DIR"
echo "REPO_DIR:   $REPO_DIR"

#Configura os Modulos
module load cuda/11.2_sequana

#Ambiente Python criado no login node: venv OU conda env (qualquer pasta com bin/python).
#Padrao: $SCRATCH/conda/envs/tg. Sobrescreva com VENV=/caminho/para/env sbatch ...
VENV=${VENV:-$SCRATCH/conda/envs/tg}
if [ ! -x "$VENV/bin/python" ]; then
  echo "ERRO: ambiente nao encontrado em $VENV (sem bin/python). Veja requirements-py310.txt." >&2
  exit 2
fi
export PATH="$VENV/bin:$PATH"
PYTHON="$VENV/bin/python"
echo "python: $PYTHON ($($PYTHON --version 2>&1))"
# Falha cedo se o torch nao estiver instalado ou for build sem CUDA
$PYTHON -c "import torch; print('torch', torch.__version__, 'cuda', torch.version.cuda, 'available', torch.cuda.is_available())" || {
  echo "ERRO: torch nao importa dentro de $VENV. Rode no login node: pip install -r requirements.txt" >&2
  exit 2
}

#Exibe as GPUs disponiveis em cada no
srun --ntasks-per-node=1 bash -c 'echo "== $(hostname) =="; nvidia-smi --query-gpu=index,name,driver_version,memory.used,memory.total --format=csv'

# ---------------------------------------------------------------------------
# Rendezvous do torchrun: o primeiro no da lista e o master.
# ---------------------------------------------------------------------------
export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=$((10000 + SLURM_JOB_ID % 20000))
# GPUs por no: conta o que o Slurm realmente alocou (nem toda versao exporta
# SLURM_GPUS_ON_NODE). Ordem: SLURM_GPUS_ON_NODE -> SLURM_GPUS_PER_NODE ("8" ou
# "v100:8") -> CUDA_VISIBLE_DEVICES -> nvidia-smi -L. Sobrescreva com GPUS_PER_NODE=N.
detect_gpus_per_node() {
  if [ -n "${SLURM_GPUS_ON_NODE:-}" ]; then echo "$SLURM_GPUS_ON_NODE"; return; fi
  if [ -n "${SLURM_GPUS_PER_NODE:-}" ]; then echo "${SLURM_GPUS_PER_NODE##*:}"; return; fi
  if [ -n "${CUDA_VISIBLE_DEVICES:-}" ]; then echo "$CUDA_VISIBLE_DEVICES" | tr ',' ' ' | wc -w | tr -d ' '; return; fi
  srun --ntasks=1 --nodes=1 nvidia-smi -L 2>/dev/null | grep -c '^GPU'
}
echo "slurm gpu vars: SLURM_GPUS_ON_NODE=${SLURM_GPUS_ON_NODE:-} SLURM_GPUS_PER_NODE=${SLURM_GPUS_PER_NODE:-} SLURM_JOB_GPUS=${SLURM_JOB_GPUS:-} CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-}"
GPUS_PER_NODE=${GPUS_PER_NODE:-$(detect_gpus_per_node)}
echo "GPUS_PER_NODE=$GPUS_PER_NODE"
if ! [ "$GPUS_PER_NODE" -ge 1 ] 2>/dev/null; then
  echo "ERRO: nao consegui detectar GPUs na alocacao (GPUS_PER_NODE='$GPUS_PER_NODE')." >&2
  exit 2
fi
NNODES=$SLURM_JOB_NUM_NODES
WORLD_SIZE=$((GPUS_PER_NODE * NNODES))
echo "MASTER_ADDR=$MASTER_ADDR MASTER_PORT=$MASTER_PORT WORLD_SIZE=$WORLD_SIZE"

# Nos de computacao do SDumont nao tem internet: modelo e dataset ja devem
# estar em hf_model_safetensors/ e dataset/data/ (baixados no login node).
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HOME=$REPO_DIR/.cache/huggingface
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=$((SLURM_CPUS_PER_TASK / GPUS_PER_NODE))
export CUDA_DEVICE_MAX_CONNECTIONS=1
export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
export TORCH_NCCL_ASYNC_ERROR_HANDLING=1

# Camadas efetivas: override ou o valor do checkpoint (para o nome do json/plots)
LAYERS=${NUM_HIDDEN_LAYERS:-$($PYTHON -c "import json; print(json.load(open('hf_model_safetensors/config.json'))['num_hidden_layers'])" 2>/dev/null || echo NA)}
RUN_TAG="dp$((WORLD_SIZE / (TP * PP)))_tp${TP}_pp${PP}_seq${SEQ_LENGTH}_mbs${MICRO_BATCH_SIZE}_layers${LAYERS}_${DTYPE}"
mkdir -p benchmarks

CMD="training/train.py \
  --tp $TP \
  --pp $PP \
  --micro-batch-size $MICRO_BATCH_SIZE \
  --seq-length $SEQ_LENGTH \
  --max-steps $MAX_STEPS \
  --warmup-steps $WARMUP_STEPS \
  ${NUM_HIDDEN_LAYERS:+--num-hidden-layers $NUM_HIDDEN_LAYERS} \
  --dtype $DTYPE \
  --backend nccl \
  --metrics-out benchmarks/${RUN_TAG}_job${SLURM_JOB_ID}.json \
  $EXTRA_ARGS"

LAUNCHER="$PYTHON -m torch.distributed.run \
  --nnodes=$NNODES \
  --nproc_per_node=$GPUS_PER_NODE \
  --rdzv_id=$SLURM_JOB_ID \
  --rdzv_backend=c10d \
  --rdzv_endpoint=${MASTER_ADDR}:${MASTER_PORT} \
  --max_restarts=0 \
  --tee 3"

echo "Running: $LAUNCHER $CMD"
srun --ntasks-per-node=1 --kill-on-bad-exit=1 $LAUNCHER $CMD
exit_status=$?

echo "========================"
echo "END TIME: $(date)  exit=$exit_status"
exit $exit_status
