    "version": "0.2.0",
    "configurations": [
        {
            "name": "DDP Multi Core",
            "type": "debugpy",
            "request": "launch",
            "module": "torch.distributed.run",
            "console": "integratedTerminal",
            "args": [
                "--rdzv-backend=c10d",
                "--rdzv-endpoint=127.0.0.1:25001",
                "--nnodes=1",
                "--nproc_per_node=8",
                "ddp_multi_core.py"
            ]
        }
    ]
}